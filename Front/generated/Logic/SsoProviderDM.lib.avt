namespace Errors {

	export enum SsoCode {
		TokenFailed,
		UserInfoFailed,
		IdentifierNotFound,
		NameNotFound,
		PictureNotFound,
		UserNotRegistered
	}

	@Convertible()
	export class SsoError extends Aventus.GenericError<typeof SsoCode>  {
		/** Fullname of the class */
		public static get Fullname(): string { return "Core.Logic.SsoError, Core"; }
	}

}