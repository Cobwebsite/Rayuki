namespace Errors {

	export enum StorageErrorCode {
		UnknowError,
		NotAllowed,
		NotFound
	}

	@Convertible()
	export class StorageError extends Aventus.GenericError<typeof StorageErrorCode>  {
		/** Fullname of the class */
		public static get Fullname(): string { return "Core.Logic.FileSystem.StorageError, Core"; }
	}

}