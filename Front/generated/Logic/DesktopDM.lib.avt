namespace Errors {

	export enum DesktopErrorCode {
		NoDefaultDesktop
	}

	@Convertible()
	export class DesktopError extends Aventus.GenericError<typeof DesktopErrorCode>  {
		/** Fullname of the class */
		public static override get Fullname(): string { return "Core.Logic.DesktopError, Core"; }
	}

}