import { PermissionQuery } from '../../libs/Permission.lib.avt';

namespace Permissions {

	export enum OsPermission {
		ConnectAs,
		ReorderApps
	}

	@Convertible()
	export class OsPermissionQuery extends PermissionQuery<typeof OsPermission>  {
		/** Fullname of the class */
		public static get Fullname(): string { return "Core.Permissions.OsPermissionQuery, Core"; }
	}

}