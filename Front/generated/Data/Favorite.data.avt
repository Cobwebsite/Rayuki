namespace Data {

	@Convertible()
	export class Favorite extends AventusSharp.Data.Storable implements Aventus.IData {
		public static override get Fullname(): string { return "Core.Data.Favorite, Core"; }
		public Name!: string;
		public TagName!: string;
		public State!: string;
		public UserId!: number;
	}

}