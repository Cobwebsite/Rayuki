namespace Data {

	@Convertible()
	export class SystemInfo extends AventusSharp.Data.SharpClass  {
		/** Fullname of the class */
		public static get Fullname(): string { return "Core.Data.SystemInfo, Core"; }
		public TimeZone!: string;
		public Version!: string;
		public BuildDate!: string;
		public AutoLogin!: boolean;
		public IsDev!: boolean;
		public NbAppInDev!: number;
		public ResetStorage!: boolean;
	}

}