import { ImageFile } from './DataTypes/ImageFile.lib.avt';

namespace Data {

	@Convertible()
	export class User extends AventusSharp.Data.Storable implements Aventus.IData {
		public static override get Fullname(): string { return "Core.Data.User, Core"; }
		public Firstname: string = "";
		public Lastname: string = "";
		public Username: string = "";
		public Password?: string = undefined;
		public Token: string = "";
		public Picture: UserPicture = new UserPicture();
		public IsSuperAdmin: boolean = false;
		public SsoProviderId?: number = undefined;
		public QuickToken?: string = undefined;
	}

	@Convertible()
	export class UserPicture extends ImageFile<User>  {
		public static get Fullname(): string { return "Core.Data.UserPicture, Core"; }
	}

}