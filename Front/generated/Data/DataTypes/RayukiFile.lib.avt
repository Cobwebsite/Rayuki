namespace Data.DataTypes {

	export abstract class RayukiFile<T extends Aventus.IData> extends AventusSharp.Data.CustomTableMembers.AventusFile<T> {

	}

	export enum FileErrorCode {
		InvalidUri,
		DownloadFailed
	}

	@Convertible()
	export class FileError extends Aventus.GenericError<typeof FileErrorCode>  {
		public static get Fullname(): string { return "Core.Data.DataTypes.FileError, Core"; }
	}

}