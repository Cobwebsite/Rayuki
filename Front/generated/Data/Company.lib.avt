import { ImageFile } from './DataTypes/ImageFile.lib.avt';

namespace Data {

	@Convertible()
	export class Company extends AventusSharp.Data.Storable implements Aventus.IData {
		public static override get Fullname(): string { return "Core.Data.Company, Core"; }
		public Name: string = "";
		public Logo: CompanyImage = new CompanyImage();
		public Version: number = 0;
		public SiteUrl: string = "";
	}

	@Convertible()
	export class CompanyImage extends ImageFile<Company>  {
		public static get Fullname(): string { return "Core.Data.CompanyImage, Core"; }
	}

}