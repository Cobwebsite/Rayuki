namespace Data {

	@Convertible()
	export class WebAuthnCredentials extends AventusSharp.Data.Storable implements Aventus.IData {
		/** Fullname of the class */
		public static override get Fullname(): string { return "Core.Data.WebAuthnCredentials, Core"; }
		public CredentialId!: string;
		public Name!: string;
		public PublicKey!: string;
		public UserId!: number;
	}

	@Convertible()
	export class WebAuthnCredentialsPublic extends AventusSharp.Data.SharpClass  {
		/** Fullname of the class */
		public static get Fullname(): string { return "Core.Data.WebAuthnCredentialsPublic, Core"; }
		public Id!: number;
		public Name!: string;
	}

}