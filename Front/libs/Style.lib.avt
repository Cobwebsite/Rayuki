

@Storybook({
    prefix: 'Front/Style',
})
export type ColorsType = 'green' | 'success' | 'red' | 'error' | 'orange' | 'warning' | 'blue' | 'information' | 'primary' | 'secondary';

@Storybook({
    prefix: 'Front/Style',
})
export const Colors = {
    'green': 'green',
    'success': 'success',
    'red': 'red',
    'error': 'error',
    'orange': 'orange',
    'warning': 'warning',
    'blue': 'blue',
    'information': 'information',
    'primary': 'primary',
    'secondary': 'secondary',
} as const;

@Storybook({
    prefix: 'Front/Style',
})
export class Style {

    public colors: ColorsType[] = ['green', 'success', 'red', 'error', 'orange', 'warning', 'blue', 'information', 'primary', 'secondary'];

    public static async getTheme(appName?: string) {
        let url = appName ? `/apps/${appName}/default.css` : `/autoload/default.css`;
        const request = new Aventus.HttpRequest(url);
        const themeResponse = await request.queryTxt();
        let result = '';
        if(themeResponse.success && themeResponse.result) {
            const matches = themeResponse.result.matchAll(/:root\{.*?\}/g);
            for(const match of matches) {
                result += match[0];
            }
        }

        return result;
    }

    public static lockVariable(el: HTMLElement, prop: string) {
        let computed = getComputedStyle(el);
        el.style.setProperty(prop, computed.getPropertyValue(prop.replace("--", "--_")))
    }
}
