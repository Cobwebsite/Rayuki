{
    "module": "Core",
    "componentPrefix": "rk",
    "build": [
        {
            "name": "Main",
            "hideWarnings": true,
            "disabled": false,
            "src": [
                "./components/*",
                "./ram/*",
                "./libs/*",
                "./states/*",
                "./generated/*",
                "./locales/*",
                "./@default.wcs.avt"
            ],
            "outsideModule": [
                "./global/*"
            ],
            "compile": [
                {
                    "output": "../wwwroot/autoload/core.js",
                    "package": "../../../Libs/RayukiCore/Core.package.avt"
                }
            ],
            "namespaceStrategy": "rules",
            "namespaceRules": {
                "System": [
                    "./components/system/*"
                ],
                "Components": [
                    "./components/components/*"
                ],
                "Lib": [
                    "./libs/*"
                ],
                "RAM": [
                    "./ram/*"
                ],
                "State": [
                    "./states/*"
                ]
            },
            "dependances": {
                "Aventus@Main": {
                    "include": "none"
                },
                "Aventus@Sharp": {
                    "include": "none"
                },
                "Aventus@I18n": {
                    "include": "none"
                },
                "MaterialIcon": {
                    "version": "1.0.0",
                    "include": "none"
                },
                "Lucide": {
                    "version": "1.0.0",
                    "include": "none"
                },
                "Addon@Addon": {
                    "include": "none",
                    "isLocal": true
                }
            },
            "stories": {
                "output": "../../Storybook",
                "format": "manual",
                "live": false,
                "prefix": "Front",
                "srcBaseUrl": "https://github.com/Cobwebsite/Rayuki/tree/develop/Front"
            },
            "i18n": {
                "autoRegister": false,
                "locales": [
                    "fr-FR",
                    "de-DE",
                    "en-GB"
                ],
                "fallback": "fr-FR"
            }
        },
        {
            "module": "Addon",
            "name": "Addon",
            "hideWarnings": true,
            "disabled": false,
            "src": [
                "./addon/*"
            ],
            "compile": [
                {
                    "package": "../../../Libs/RayukiCore/Addon.package.avt"
                }
            ],
            "dependances": {
                "QrCodeReader": {
                    "version": "1.0.0",
                    "include": "full"
                },
                "QrCodeGenerator": {
                    "version": "1.0.0",
                    "include": "full"
                },
                "Univer": {
                    "version": "1.0.0",
                    "include": "full"
                }
            }
        },
        {
            "name": "Login",
            "hideWarnings": true,
            "disabled": false,
            "src": [
                "./apps/login/*",
                "./components/*",
                "./ram/*",
                "./libs/*",
                "./states/*",
                "./generated/*",
                "./locales/*",
                "./@default.wcs.avt"
            ],
            "compile": [
                {
                    "output": "../wwwroot/login.js"
                }
            ],
            "dependances": {
                "Aventus@Main": {},
                "Aventus@Sharp": {},
                "Aventus@I18n": {},
                "Core@Main": {
                    "isLocal": true,
                    "include": "need"
                }
            }
        },
        {
            "name": "ConfigureApp",
            "hideWarnings": true,
            "disabled": true,
            "src": [
                "./apps/configureApp/*",
                "./components/*",
                "./ram/*",
                "./libs/*",
                "./states/*",
                "./generated/*",
                "./locales/*",
                "./@default.wcs.avt"
            ],
            "outsideModule": [
                "./global/*"
            ],
            "compile": [
                {
                    "input": "./apps/configureApp/",
                    "output": "../wwwroot/configureApp.js"
                }
            ],
            "dependances": {
                "Aventus@Main": {},
                "Aventus@Sharp": {},
                "Aventus@I18n": {},
                "MaterialIcon": {
                    "version": "1.0.0"
                },
                "Lucide": {
                    "version": "1.0.0"
                },
                "Core:Main": {
                    "isLocal": true
                }
            }
        },
        {
            "name": "Aventus",
            "src": [],
            "compile": [
                {
                    "output": "../wwwroot/autoload/aventus.js",
                    "compressed": false
                }
            ],
            "dependances": {
                "Aventus@Main": {
                    "include": "full"
                },
                "Aventus@Sharp": {
                    "include": "full"
                },
                "Aventus@I18n": {
                    "include": "full"
                },
                "MaterialIcon": {
                    "version": "1.0.0",
                    "include": "full"
                },
                "Lucide": {
                    "version": "1.0.0",
                    "include": "full"
                }
            }
        }
    ],
    "static": [
        {
            "name": "Main",
            "input": "./static/*",
            "output": "../wwwroot/"
        }
    ],
    "aliases": {
        "@root": "./"
    }
}