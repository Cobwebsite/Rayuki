import { Panel } from "../../Panel/Panel.wcl.avt";
import type { Scrollable } from "../../../ui/layout/Scrollable/Scrollable.wcl.avt";
import { SessionManager } from "../../../../libs/SessionManager.lib.avt";
import type { User } from "../../../../generated/Data/User.lib.avt";
import { Desktop } from "../../Desktop/Desktop.wcl.avt";
import type { HomeBtn } from "../HomeBtn.wcl.avt";
import { ApplicationPermission, ApplicationPermissionQuery } from "../../../../generated/Permissions/ApplicationPermission.lib.avt";
import { FavoriteRAM } from "../../../../ram/Favorite.ram.avt";
import { Process } from "../../../../libs/Process.lib.avt";
import type { Favorite } from "../../../../generated/Data/Favorite.data.avt";
import { FavoriteLine } from "../FavoriteLine/FavoriteLine.wcl.avt";
import { NormalizedEvent, PressManager } from "Aventus@Main:Aventus.package.avt";
import { NotificationManager } from "../../../../libs/NotificationManager.lib.avt";

namespace System {
    export class HomePanel extends Panel implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props

        //#endregion


        //#region variables
        @ViewElement()
        protected recentContainer!: Scrollable;

        @ViewElement()
        protected favorisContainer!: Scrollable;

        @Watch()
        public currentUser?: User;

        public btn!: HomeBtn;

        @Watch()
        public favorites: Favorite[] = [];
        @Watch()
        public reorderFav: boolean = false;



        //#endregion


        //#region constructor

        //#endregion


        //#region methods



        /**
         * 
         */
        protected async openProfil() {
            const canSettings = await can(new ApplicationPermissionQuery(ApplicationPermission.AllowAccess, "Settings"));
            if(canSettings) {
                let desktop = this.findParentByType(Desktop);
                if(desktop) {
                    desktop.openUrl("Settings", "/", "/profil");
                    this.btn.active = false;
                }
            }
        }


        /**
         * 
         */
        protected async logout() {
            SessionManager.logout();
        }


        private async displayRecent() {
            // for(let i = 0; i < 20; i++) {
            //     let test = new AppIconInline();
            //     let icon = Aventus.WebComponentInstance.create<AppIcon>("Cave.System.AppIcon");
            //     let app = await ApplicationRAM.getInstance().getApplicationByName("Cave");
            //     if(icon && app) {
            //         test.setIcon(icon);
            //         test.text = app.DisplayName;
            //     }

            //     this.recentContainer.appendChild(test);
            // }
        }



        private async getUser() {
            this.currentUser = await SessionManager.getUser();
        }

        private async initRam() {
            let ram = FavoriteRAM.getInstance();
            ram.onCreated(this.loadData);
            ram.onUpdated((item) => this.loadData(item, true));
            ram.onDeleted(this.loadData);
            this.loadData();
        }

        @BindThis()
        private async loadData(item?: Favorite, force?: boolean) {
            let ram = FavoriteRAM.getInstance();
            const items = await Process.execute(this, ram.getListWithError());
            if(items) {
                items.sort((a, b) => a.Order - b.Order);
                if(force) {
                    this.favorites = [];
                }
                this.favorites = items;
            }
        }

        public saveFavoriteOrder() {
            let children = Array.from(this.favorisContainer.children[0].children);
            let i = 0;
            const toSave: Favorite[] = [];
            for(let child of children) {
                if(child instanceof FavoriteLine) {
                    if(child.favorite && child.favorite.Order != i) {
                        const clone = child.favorite.clone();
                        clone.Order = i;
                        toSave.push(clone);
                    }

                    i++;
                }
            }
            if(toSave.length > 0) {
                FavoriteRAM.getInstance().updateListWithError(toSave);
            }
        }

        public stopReorderFavorite() {
            const children = Array.from(this.favorisContainer.children[0].children);
            for(let child of children) {
                if(child instanceof FavoriteLine) {
                    child.reorder = false;
                }
            }
            PressManager.onEvent.remove(this.checkCancelState);
            this.reorderFav = false;
        }
        public startReorderFavorite() {
            const children = Array.from(this.favorisContainer.children[0].children);
            for(let child of children) {
                if(child instanceof FavoriteLine) {
                    child.reorder = true;
                }
            }
            PressManager.onEvent.add(this.checkCancelState);
            this.reorderFav = true;
        }

        @BindThis()
        protected checkCancelState(e: NormalizedEvent, instance: PressManager) {
            if(e.event.type != "pointerdown" && e.event.type != "touchstart") {
                return;
            }
            const el = instance.getElement();
            const parentNode = el.parentNode;
            if(el.classList.contains("drag-icon") && parentNode instanceof ShadowRoot) {
                if(parentNode.host instanceof FavoriteLine) {
                    return;
                }
            }
            this.stopReorderFavorite();
        }


        protected override postCreation(): void {
            this.getUser();
            this.displayRecent();
            this.initRam();
            new PressManager({
                element: this,
                onPress: () => { },
                onDrag: () => { },
            });
        }


        //#endregion

    }
}