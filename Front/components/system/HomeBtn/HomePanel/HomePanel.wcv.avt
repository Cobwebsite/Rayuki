<div class="content">
    <rk-row>
        <rk-col size="6">
            <div class="recent">
                <div class="title">{{ t("Récents") }}</div>
                <rk-scrollable class="scrollable recent-container" @element="recentContainer" floating_scroll>
                    for(let recent of this.recents) { 
                            <rk-recent-line :recent="recent"></rk-recent-line>
                        }
                </rk-scrollable>
            </div>
        </rk-col>
        <rk-col size="6">
            <div class="favoris">
                <div class="title">{{ t("Mes favoris") }}</div>
                <rk-scrollable @element="favorisContainer" class="scrollable favoris-container" floating_scroll>
                    <div class="wrapper">
                        for(let fav of this.favorites) { 
                            <rk-favorite-line :favorite="fav" :reorder="this.reorderFav"></rk-favorite-line>
                        }
                    </div>
                </rk-scrollable>
            </div>
        </rk-col>
    </rk-row>
</div>
<div class="footer">
    <div @press="openProfil" class="person touch">
        <rk-user-profil-picture class="icon" uri="{{ this.currentUser?.Picture.Uri }}"></rk-user-profil-picture>
        <div class="name">{{ this.currentUser?.Firstname }} {{ this.currentUser?.Lastname }}</div>
    </div>
    <div class="actions">
        <rk-notification-btn class="btn"></rk-notification-btn>
        <rk-pwa-button>
            <rk-tooltip position="top" delay="1000" use_absolute color="green">{{ t("Installer l'application") }}</rk-tooltip>
        </rk-pwa-button>
        <rk-button icon="/img/icons/power-off.svg" @press="logout"></rk-button>
    </div>
</div>