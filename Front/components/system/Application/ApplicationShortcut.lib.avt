import { ShortcutManager, SpecialTouch } from "../../../libs/ShortcutManager.lib.avt";
import type { Application } from "./Application.wcl.avt";
import { PopupShortcutHelper } from "./PopupShortcutHelper/PopupShortcutHelper.wcl.avt";

namespace System {

    export class ApplicationShortcut {
        private application: Application;
        protected cmds: [string, (string | SpecialTouch)[], cb: () => any][] = [];
        protected shortcuts: [string, (string | SpecialTouch)[], cb: () => any][] = [];
        public is_cmd: boolean = false;


        public constructor(application: Application) {
            this.application = application;
        }

        public init() {
        }

        /**
         *  Defines the keyboard shortcuts for the application.
         */
        protected defaultShortcut(): [string, (string | SpecialTouch)[], cb: () => any][] {
            return [
                [t("Déplacer l'application à gauche"), [SpecialTouch.Control, SpecialTouch.ArrowLeft], this.application.moveApplicationToLeft],
                [t("Déplacer l'application à droite"), [SpecialTouch.Control, SpecialTouch.ArrowRight], this.application.moveApplicationToRight],
                [t("Ouvrir l'aide des raccourcis clavier"), [SpecialTouch.Control, "h"], this.showPopupHelp],
                ["", [SpecialTouch.Control, 'k'], this.startCmd],
            ];
        }

        public manageShortcut() {
            this.cmds = this.defineCmds();
            let shortcuts = this.defaultShortcut();
            let customShortcut = this.application.defineShortcut();
            for(let shortcut of customShortcut) {
                shortcuts.push(shortcut);
            }
            this.shortcuts = shortcuts;
            if(this.application.is_desktop_active) {
                for(let shortcut of shortcuts) {
                    ShortcutManager.subscribe(shortcut[1], shortcut[2]);
                }
            }
            else {
                for(let shortcut of shortcuts) {
                    ShortcutManager.unsubscribe(shortcut[1], shortcut[2]);
                }
            }
        }


        protected defineCmds(): [string, (string | SpecialTouch)[], cb: () => any][] {
            return [
                ["Print the state", ['s'], this.runCmd(this.printState)],
            ];
        }

        @BindThis()
        protected startCmd() {
            for(let cmd of this.cmds) {
                ShortcutManager.subscribe(cmd[1], cmd[2]);
            }
            this.is_cmd = true;
            setTimeout(() => {
                this.stopCmd();
            }, 2000);
        }

        @BindThis()
        protected stopCmd() {
            if(!this.is_cmd) return;

            this.is_cmd = false;
            for(let cmd of this.cmds) {
                ShortcutManager.unsubscribe(cmd[1], cmd[2]);
            }
        }

        protected runCmd(fct: () => any) {
            return () => {
                try {
                    fct();
                } catch {

                }
                this.stopCmd();
            };
        }

        @BindThis()
        protected printState() {
            console.log(this.application.navigator.getState());
        }

        @BindThis()
        protected showPopupHelp() {
            let p = new PopupShortcutHelper();
            p.shortcuts = this.shortcuts.filter(p => p[0] != "").map((p) => [p[0], p[1]]);
            p.cmds = this.cmds.filter(p => p[0] != "").map((p) => [p[0], p[1]]);
            this.application.popup(p);
        }
    }
}

