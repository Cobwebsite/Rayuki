<div class="header">
    <mi-icon icon="chevron_left" class="chevron touch hover" @press="previousMonth"></mi-icon>
    <div class="current-info" @press="showMonthSelect">
        <div class="month-year touch hover">
            <div class="month" @element="monthEl"></div>
            <div class="year" @element="yearEl"></div>
        </div>
    </div>
    <mi-icon icon="chevron_right" class="chevron touch hover" @press="nextMonth"></mi-icon>

    <div class="selectors">
        <div class="month-select">
            <div class="month-select-header">
                <mi-icon icon="chevron_left" class="chevron touch hover" @press="previousYearTemp"></mi-icon>
                <div class="current-info" @press="showYearSelect">
                    <div class="temp-year touch hover">
                        {{ this.dateTemp.getFullYear() }}
                    </div>
                </div>
                <mi-icon icon="chevron_right" class="chevron touch hover" @press="nextMonthYearTemp"></mi-icon>
            </div>
            <div class="month-select-body" @element="bodyMonthEl">
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(0, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(1, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(2, true) }}</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(3, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(4, true) }}</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(5, true) }}</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(6, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(7, true) }}</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(8, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(9, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(10, true) }}.</div>
                <div class="month-el touch hover" @press="selectMonthTemp">{{ DateTools.getMonthName(11, true) }}.</div>
            </div>
        </div>
        <div class="year-select">
            <div class="year-select-header">
                <mi-icon icon="chevron_left" class="chevron touch hover" @press="previousYearGroupTemp"></mi-icon>
                <div class="current-info">
                    <div class="temp-year-range">
                        {{ this.yearGroupTxt }}
                    </div>
                </div>
                <mi-icon icon="chevron_right" class="chevron touch hover" @press="nextYearGroupTemp"></mi-icon>
            </div>
            <div class="year-select-body" @element="bodyYearEl">

            </div>
        </div>
    </div>
</div>
<div class="body">
    <div class="days-header">
        <div class="day-header">{{ DateTools.getDayName(1, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(2, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(3, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(4, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(5, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(6, true) }}</div>
        <div class="day-header">{{ DateTools.getDayName(0, true) }}</div>
    </div>
    <div class="days-body" @element="bodyEl">

    </div>
</div>
<div class="hider" @press="hideSelector"></div>