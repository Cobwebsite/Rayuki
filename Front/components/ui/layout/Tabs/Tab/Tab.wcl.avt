import type { TabHeader } from "../TabHeader/TabHeader.wcl.avt";

namespace Components {
    @Storybook({
        export: 'public',
        group: 'Components/Layout'
    })
    export class Tab extends Aventus.WebComponent implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props
        @Attribute()
        public label: string = "";

        @Attribute()
        public selected!: boolean;

        @Property((target: Tab) => {
            if(target.tabHeader)
                target.tabHeader.disabled = target.disabled;
        })
        public disabled!: boolean;

        @Property((target: Tab) => {
            if(target.tabHeader)
                target.tabHeader.hidded = target.hidded;
        })
        public hidded!: boolean;
        //#endregion


        //#region variables
        public get headerContent(): HTMLElement[] {
            let elements = this.getElementsInSlot("header");
            return elements;
        }

        @InternalProtected()
        public tabHeader?: TabHeader;
        //#endregion


        //#region constructor

        //#endregion


        //#region methods

        //#endregion

    }
}