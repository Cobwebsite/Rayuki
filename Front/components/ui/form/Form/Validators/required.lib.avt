import { FormValidator } from "./Validator.lib.avt";

namespace Components {

    export class Required extends FormValidator<any> {
        protected msg: string;

        public constructor(msg?: string) {
            super();
            this.msg = msg ?? "Le champs {name} est requis";
        }
        /**
         * @inheritdoc
         */
        public override validate(value: any | undefined, name: string, globalValidation: () => Promise<void>): string | boolean {
            const txt = this.msg.replace(/\{ *name *\}/g, name);
            if(value === undefined || value === null) {
                return txt;
            }
            if(typeof value == 'string' && value.trim() == "") {
                return txt;
            }

            return true;
        }

    }
}