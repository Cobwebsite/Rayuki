import { Validator } from "../../../../../libs/Validator.lib.avt";
import { FormValidator } from "./Validator.lib.avt";


namespace Components {

    export class Email extends FormValidator<string> {
        public msg: string;

        public constructor(msg?: string) {
            super();
            this.msg = msg ?? "Merci de saisir un email valide";
        }

        /**
         * @inheritdoc
         */
        public override validate(value: string | undefined, name: string, globalValidation: () => Promise<void>): boolean | string {
            if(typeof value == "string" && value) {
                if(Validator.email(value)) {
                    return true;
                }
                return this.msg;
            }
            return true;
        }

    }
}