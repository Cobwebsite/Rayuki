import { CheckboxItem } from "../CheckboxItem/CheckboxItem.wcl.avt";
import { FormElement } from "../FormElement/FormElement.wcl.avt";

namespace Components {
    @Storybook({
        export: 'public',
        group: 'Components/Form'
    })
    export class CheckboxGroup<T> extends FormElement<T> implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props
        @Property()
        public multiple!: boolean;
        @Attribute()
        public no_undefined!: boolean;
        //#endregion


        //#region variables
        @Watch((target: CheckboxGroup<T>) => {
            target.onValueSet();
        })
        public override value: T | undefined;

        protected options: CheckboxItem<T>[] = [];

        protected selectedOption?: CheckboxItem<T>;
        private isLoading: boolean = false;
        //#endregion


        //#region constructor

        //#endregion


        //#region methods
        protected loadCheckbox() {
            this.isLoading = true;
            const elements = this.getElementsInSlot();
            const options: CheckboxItem<T>[] = [];
            let triggerChange = false;
            for(let element of elements) {
                if(element instanceof CheckboxItem) {
                    options.push(element);
                    if(this.value == undefined && this.no_undefined) {
                        this.value = element.value;
                        triggerChange = true;
                    }
                    if(element.value == this.value) {
                        element.checked = true;
                        this.selectedOption = element;
                    }
                    element.onChange.remove(this.onChangeValue);
                    element.onChange.add(this.onChangeValue);
                    element.no_undefined = this.no_undefined;
                }
            }
            this.options = options;
            this.isLoading = false;
            if(triggerChange) {
                this.onChange.trigger(this.value);
                if(this.formPart) {
                    this.formPart.value.set(this.value);
                }
            }
        }
        protected onValueSet() {
            if(this.isLoading) return;
            // select
            let selected: CheckboxItem<T> | undefined = undefined;
            for(let option of this.options) {
                if(option.value == this.value) {
                    selected = option;
                    break;
                }
            }
            if(this.selectedOption) {
                this.selectedOption.checked = false;
            }
            this.selectedOption = selected;
            if(this.selectedOption) {
                this.selectedOption.checked = true;
            }
        }

        @BindThis()
        protected onChangeValue(value: T | undefined) {
            this.value = value;
            this.onChange.trigger(this.value);
            if(this.formPart) {
                this.formPart.value.set(this.value);
            }
        }

        protected override postCreation(): void {
            super.postCreation();
            this.loadCheckbox();
        }
        //#endregion

    }
}